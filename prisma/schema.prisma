datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// Live In-Site Dynamic Content Management
model SiteContent {
  id        String   @id @default(cuid())
  scope     String   // "GLOBAL", "PHOTOGRAPHY", "MEDIA", "PORTAL"
  section   String   // "HERO", "ARCHIVE", "COMMISSION", "FOOTER", "ABOUT"
  key       String   // "badge", "title", "description", etc.
  value     String
  updatedAt DateTime @updatedAt

  @@unique([scope, section, key])
}

// Configurable Studio Highlight Callouts
model StudioFeature {
  id          String   @id @default(cuid())
  scope       String   // "PHOTOGRAPHY" or "MEDIA"
  icon        String   // Lucide icon name: "Camera", "Compass", "Award", "Aperture"
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Dynamic Ecosystem Module Capability Toggles
model SystemModule {
  id          String   @id @default(cuid())
  key         String   @unique // "GEAR_DESK", "CLIENT_PORTAL", "MANGA_READER", "GAME_SERVERS"
  label       String
  description String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Live Game Server Telemetry Nodes (Native to Gamehosting-by-Graywood-2)
model GameServer {
  id           String   @id @default(cuid())
  name         String
  gameType     String   // e.g., "Assetto Corsa", "Unreal Engine Testbed"
  protocolType String   // Gamedig query protocol
  endpoint     String   // "play.graywood.no:27015"
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Ingested Media Asset Registry (Photoview / Immich read-only model)
model MediaAsset {
  id           String      @id @default(cuid())
  filename     String
  originalPath String      @unique
  hash         String      @unique // SHA-256
  mimeType     String
  sizeBytes    BigInt
  width        Int         @default(0)
  height       Int         @default(0)
  cameraModel  String?
  lensModel    String?
  focalLength  String?
  iso          Int?
  aperture     String?
  shutterSpeed String?
  capturedAt   DateTime?
  isPublic     Boolean     @default(false)
  category     String?     // "LANDSCAPE", "ARCHITECTURE", "PORTRAIT"
  indexedAt    DateTime    @default(now())
  albumItems   AlbumItem[]
}

model Album {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  clientName  String?
  pinHash     String?     // For client proofing vaults
  type        String      @default("PORTFOLIO") // "PORTFOLIO" | "CLIENT_PROOFING"
  createdAt   DateTime    @default(now())
  items       AlbumItem[]
}

model AlbumItem {
  id        String     @id @default(cuid())
  albumId   String
  assetId   String
  order     Int        @default(0)
  album     Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([albumId, assetId])
}

// Co-Owner Gear Desk & Equipment Custody Logs
model GearItem {
  id              String            @id @default(cuid())
  name            String
  brand           String
  category        String            // "BODY", "LENS", "LIGHTING", "DRONE", "AUDIO"
  serialNumber    String?
  storageLocation String            @default("Main Studio Locker")
  status          String            @default("AVAILABLE") // "AVAILABLE" | "CHECKED_OUT" | "MAINTENANCE"
  custodian       String?
  checkedOutAt    DateTime?
  expectedReturn  DateTime?
  notes           String?
  checkoutLogs    GearCheckoutLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model GearCheckoutLog {
  id         String   @id @default(cuid())
  gearItemId String
  custodian  String
  action     String   // "CHECKOUT" | "CHECKIN"
  notes      String?
  timestamp  DateTime @default(now())
  gearItem   GearItem @relation(fields: [gearItemId], references: [id], onDelete: Cascade)
}

// Superadmin & Role Authentication
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

// Brand Settings & Color Overrides
model BrandSettings {
  id           String   @id @default(cuid())
  scope        String   @unique // "GLOBAL", "PHOTOGRAPHY", "MEDIA"
  studioTitle  String   @default("Graywood")
  tagline      String   @default("Visual Craft & Shared Infrastructure")
  canvasColor  String   @default("#F9F8F6")
  surfaceColor String   @default("#FFFFFF")
  borderColor  String   @default("#E8E5DF")
  inkColor     String   @default("#1C1B19")
  pineColor    String   @default("#2D3B36")
  updatedAt    DateTime @updatedAt
}

// Client Inquiries Ledger
model ContactInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  discipline   String   @default("Editorial Campaign")
  budgetTier   String?
  details      String   @default("")
  message      String   @default("")
  domainSource String   @default("PHOTOGRAPHY")
  status       String   @default("NEW") // "NEW" | "REVIEWED" | "ARCHIVED"
  createdAt    DateTime @default(now())
}
