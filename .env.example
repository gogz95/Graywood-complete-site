# ==============================================================================
# Graywood Environment Variables Template
# Copy this file to .env and adjust values prior to starting containers:
#   cp .env.example .env   (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
# ==============================================================================

# Database Configuration
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=change_me_in_production
MYSQL_ROOT_PASSWORD=change_root_in_production

# WordPress Initial Admin Account
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change_admin_pass_in_production
WORDPRESS_ADMIN_EMAIL=admin@example.com

# Client Delivery Vault Password
CLIENT_PORTAL_PASSWORD=change_client_pass_in_production

# Multi-Domain Hostnames (RFC 2606 placeholders)
PRIMARY_DOMAIN=hub.example.com
MEDIA_DOMAIN=media.example.com
PHOTOGRAPHY_DOMAIN=photography.example.com

# Port Mapping (Host:Container)
HTTP_PORT=8080
