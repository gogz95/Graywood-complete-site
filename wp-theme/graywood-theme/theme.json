{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "link": true,
      "palette": [
        { "slug": "nordic-canvas",  "color": "#F9F8F6", "name": "Canvas" },
        { "slug": "nordic-surface", "color": "#FFFFFF", "name": "Surface" },
        { "slug": "nordic-muted",   "color": "#F1EFEA", "name": "Muted" },
        { "slug": "nordic-border",  "color": "#E8E5DF", "name": "Border" },
        { "slug": "nordic-divider", "color": "#DDD9D0", "name": "Divider" },
        { "slug": "nordic-ink",     "color": "#1C1B19", "name": "Ink" },
        { "slug": "nordic-subtle",  "color": "#68655E", "name": "Subtle" },
        { "slug": "nordic-faint",   "color": "#9E9B93", "name": "Faint" },
        { "slug": "nordic-pine",    "color": "#2D3B36", "name": "Pine" },
        { "slug": "nordic-clay",    "color": "#C86D51", "name": "Clay" }
      ],
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "slug": "playfair",
          "name": "Playfair Display",
          "fontFace": [
            {
              "fontFamily": "Playfair Display",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/PlayfairDisplay-Variable.ttf"]
            }
          ]
        },
        {
          "fontFamily": "Inter, system-ui, sans-serif",
          "slug": "inter",
          "name": "Inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/Inter-Variable.ttf"]
            }
          ]
        },
        {
          "fontFamily": "'JetBrains Mono', monospace",
          "slug": "jetbrains-mono",
          "name": "JetBrains Mono",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/JetBrainsMono-Regular.ttf"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "tiny",   "size": "10px",  "name": "Tiny" },
        { "slug": "x-small","size": "11px",  "name": "Extra Small" },
        { "slug": "small",  "size": "12px",  "name": "Small" },
        { "slug": "medium", "size": "14px",  "name": "Medium" },
        { "slug": "large",  "size": "18px",  "name": "Large" },
        { "slug": "x-large","size": "24px",  "name": "Extra Large" },
        { "slug": "xx-large","size": "30px", "name": "2XL" },
        { "slug": "hero",   "size": "clamp(2.25rem, 5vw, 3.75rem)", "name": "Hero" }
      ]
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },

    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "10", "size": "4px",  "name": "4px" },
        { "slug": "20", "size": "8px",  "name": "8px" },
        { "slug": "30", "size": "16px", "name": "16px" },
        { "slug": "40", "size": "24px", "name": "24px" },
        { "slug": "50", "size": "32px", "name": "32px" },
        { "slug": "60", "size": "48px", "name": "48px" },
        { "slug": "70", "size": "64px", "name": "64px" },
        { "slug": "80", "size": "80px", "name": "80px" }
      ]
    },
    "dimensions": {
      "minHeight": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--nordic-canvas)",
      "text": "var(--wp--preset--color--nordic-ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0px",
        "bottom": "0px",
        "left": "var(--wp--preset--spacing--30)",
        "right": "var(--wp--preset--spacing--30)"
      }
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--nordic-pine)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--nordic-ink)" }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontWeight": "400",
          "lineHeight": "1.1"
        },
        "color": { "text": "var(--wp--preset--color--nordic-ink)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--nordic-pine)",
          "text": "#FFFFFF"
        },
        "border": { "radius": "12px" },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500"
        },
        ":hover": {
          "color": { "background": "#1e2824" }
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": { "background": "var(--wp--preset--color--nordic-border)" },
        "border": { "width": "1px", "style": "solid" }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500"
        },
        "color": {
          "text": "var(--wp--preset--color--nordic-subtle)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-client-delivery", "title": "Client Delivery", "postTypes": ["page"] }
  ]
}
