{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "link": true,
      "palette": [
        { "slug": "pure-white",     "color": "#ffffff", "name": "Pure White" },
        { "slug": "off-white",      "color": "#fafafa", "name": "Off-White" },
        { "slug": "neutral-border", "color": "#eaeaea", "name": "Neutral Border" },
        { "slug": "muted-gray",     "color": "#666666", "name": "Muted Gray" },
        { "slug": "deep-black",     "color": "#111111", "name": "Deep Black" },
        { "slug": "nordic-canvas",  "color": "#fafafa", "name": "Canvas" },
        { "slug": "nordic-surface", "color": "#ffffff", "name": "Surface" },
        { "slug": "nordic-muted",   "color": "#f4f4f4", "name": "Muted" },
        { "slug": "nordic-border",  "color": "#eaeaea", "name": "Border" },
        { "slug": "nordic-divider", "color": "#e0e0e0", "name": "Divider" },
        { "slug": "nordic-ink",     "color": "#111111", "name": "Ink" },
        { "slug": "nordic-subtle",  "color": "#666666", "name": "Subtle" },
        { "slug": "nordic-faint",   "color": "#999999", "name": "Faint" },
        { "slug": "nordic-pine",    "color": "#2d3b36", "name": "Pine" },
        { "slug": "nordic-clay",    "color": "#c86d51", "name": "Clay" }
      ],
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "slug": "playfair",
          "name": "Playfair Display",
          "fontFace": [
            {
              "fontFamily": "Playfair Display",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/PlayfairDisplay-Variable.ttf"]
            }
          ]
        },
        {
          "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "inter",
          "name": "Inter",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/Inter-Variable.ttf"]
            }
          ]
        },
        {
          "fontFamily": "'JetBrains Mono', monospace",
          "slug": "jetbrains-mono",
          "name": "JetBrains Mono",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/JetBrainsMono-Regular.ttf"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "tiny",    "size": "11px", "name": "Tiny" },
        { "slug": "small",   "size": "13px", "name": "Small" },
        { "slug": "medium",  "size": "16px", "name": "Medium" },
        { "slug": "large",   "size": "20px", "name": "Large" },
        { "slug": "x-large", "size": "28px", "name": "Extra Large" },
        { "slug": "xx-large","size": "36px", "name": "2XL" },
        { "slug": "hero",    "size": "clamp(2.5rem, 5vw, 4rem)", "name": "Hero" }
      ]
    },
    "layout": {
      "contentSize": "840px",
      "wideSize": "1280px"
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "10", "size": "4px",  "name": "4px" },
        { "slug": "20", "size": "8px",  "name": "8px" },
        { "slug": "30", "size": "16px", "name": "16px" },
        { "slug": "40", "size": "24px", "name": "24px" },
        { "slug": "50", "size": "32px", "name": "32px" },
        { "slug": "60", "size": "48px", "name": "48px" },
        { "slug": "70", "size": "64px", "name": "64px" },
        { "slug": "80", "size": "80px", "name": "80px" }
      ]
    },
    "dimensions": {
      "minHeight": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--off-white)",
      "text": "var(--wp--preset--color--deep-black)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "padding": {
        "top": "0px",
        "bottom": "0px",
        "left": "24px",
        "right": "24px"
      },
      "blockGap": "32px"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--deep-black)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--muted-gray)" }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontWeight": "400",
          "lineHeight": "1.15"
        },
        "color": { "text": "var(--wp--preset--color--deep-black)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--deep-black)",
          "text": "#ffffff"
        },
        "border": { "radius": "9999px" },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500"
        },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--nordic-pine)" }
        }
      }
    },
    "blocks": {
      "core/separator": {
        "color": { "background": "var(--wp--preset--color--neutral-border)" },
        "border": { "width": "1px", "style": "solid" }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "500"
        },
        "color": {
          "text": "var(--wp--preset--color--muted-gray)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-client-delivery", "title": "Client Delivery", "postTypes": ["page"] }
  ]
}
